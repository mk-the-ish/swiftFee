/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by default, restricting access unless explicitly allowed.
 * It assumes an administrative backend is responsible for managing most data.
 * Data validation is relaxed to facilitate rapid prototyping and schema iteration.
 *
 * Data Structure:
 * - /students/{studentId}: Student records.
 * - /bankAccounts/{accountId}: Bank account information.
 * - /payments/{paymentId}: Payment records.
 * - /transactions/{transactionId}: Bank transaction history.
 * - /settings/exchangeRate: Exchange rate settings (single document).
 *
 * Key Security Decisions:
 * - Students, bankAccounts, and payments are not directly listable by clients, only accessible with a known ID.
 * - Bank transactions are not directly accessible by clients.
 * - Only signed-in users are allowed to create, update, or delete any documents.
 * - No schema validation is performed beyond checking required fields for authorization.
 *
 * Denormalization for Authorization:
 *  N/A - No denormalization needed in this basic ruleset. More complex rulesets may require denormalizing owner/role data.
 * Structural Segregation:
 *  N/A - This ruleset doesn't segregate public vs. private data; it assumes all data is private.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the /students collection. Only allows authenticated users to create, update, or delete students. Gets and lists are denied.
     * @path /students/{studentId}
     * @allow (create) - Authenticated user can create a student.
     * @deny (get, list) - No one can get or list students.
     * @deny (update, delete) - No one can update or delete students without authentication.
     * @principle Authenticated users can manage student records, get and list is denied.
     */
    match /students/{studentId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Protects the /bankAccounts collection. Only allows authenticated users to create, update, or delete bank accounts. Gets and lists are denied.
     * @path /bankAccounts/{accountId}
     * @allow (create) - Authenticated user can create a bank account.
     * @deny (get, list) - No one can get or list bank accounts.
     * @deny (update, delete) - No one can update or delete bank accounts without authentication.
     * @principle Authenticated users can manage bank accounts, get and list is denied.
     */
    match /bankAccounts/{accountId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Protects the /payments collection. Only allows authenticated users to create, update, or delete payments. Gets and lists are denied.
     * @path /payments/{paymentId}
     * @allow (create) - Authenticated user can create a payment.
     * @deny (get, list) - No one can get or list payments.
     * @deny (update, delete) - No one can update or delete payments without authentication.
     * @principle Authenticated users can manage payments, get and list is denied.
     */
    match /payments/{paymentId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Protects the /transactions collection. Only allows authenticated users to create, update, or delete transactions. Gets and lists are denied.
     * @path /transactions/{transactionId}
     * @allow (create) - Authenticated user can create a transaction.
     * @deny (get, list) - No one can get or list transactions.
     * @deny (update, delete) - No one can update or delete transactions without authentication.
     * @principle Authenticated users can manage transactions, get and list is denied.
     */
    match /transactions/{transactionId} {
      allow get: if false;
      allow list: if isSignedIn(); //Fixed: The FirebaseErrorListener.tsx component was failing because it could not list transactions. Added listing ability, but only to signed in users.
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Protects the /settings/exchangeRate document. Only allows authenticated users to create, update, or delete the exchange rate. Gets is allowed, lists are denied since it is a document.
     * @path /settings/exchangeRate
     * @allow (get) - Anyone can get the exchange rate.
     * @allow (create) - Authenticated user can create the exchange rate.
     * @deny (list) - No one can list the exchange rate document (since it is a single document).
     * @deny (update, delete) - No one can update or delete the exchange rate without authentication.
     * @principle Authenticated users can manage the exchange rate, get is allowed to anyone.
     */
    match /settings/exchangeRate {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }

  // Helper function to determine if a user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }
}