/**
 * @fileoverview Firestore Security Rules for the school fees management application.
 *
 * Core Philosophy:
 * This ruleset employs a hybrid security model with ownership-based access for student data and role-based access for administrative data.
 * It prioritizes strong authorization and protects against common security pitfalls like open writes and insecure queries.
 *
 * Data Structure:
 * - /exchangeRates/{exchangeRateId}: Publicly readable collection for exchange rates. Write access not defined, add an owner ID if write access is required.
 * - /bankAccounts/{bankAccountId}: Collection for bank account information, accessible only to users with the 'bursar' role defined in /roles_bursar/{userId}.
 * - /students/{studentId}: Collection for student information, accessible to all authenticated users (for now).
 * - /students/{studentId}/feesPayments/{feesPaymentId}: Subcollection of student data, restricted to the specific student.
 * - /termBilling/{termBillingId}: Collection for term billing information, accessible only to users with the 'bursar' role defined in /roles_bursar/{userId}.
 * - /roles_bursar/{userId}: Collection to define users with the 'bursar' role.
 *
 * Key Security Decisions:
 * - Public read access to exchange rates.
 * - Bursar role required to access bank accounts and term billing information.
 * - Students can only manage their own fee payment records.
 * - Data validation is limited to authorization-critical fields to enable rapid prototyping.
 *
 * Denormalization for Authorization:
 * - The rules avoid `get()` calls by assuming role information can be inferred from the `/roles_bursar/{userId}` collection.
 * - The rules rely on role based security for administrative functions by inspecting roles.
 *
 * Structural Segregation:
 * - Student data and administrative data are stored in separate collections with distinct access control rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to exchange rates. Write access is not defined, add an owner ID if write access is required.
     * @path /exchangeRates/{exchangeRateId}
     * @allow get, list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Allows public read access to exchange rates.
     */
    match /exchangeRates/{exchangeRateId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows users with the 'bursar' role to manage bank account information.
     * @path /bankAccounts/{bankAccountId}
     * @allow get, list: if isBursar();
     * @allow create: if isBursar();
     * @allow update: if isBursar() && resource != null;
     * @allow delete: if isBursar() && resource != null;
     * @principle Enforces role-based access control for sensitive financial data.
     */
    match /bankAccounts/{bankAccountId} {
      allow get, list: if isBursar();
      allow create: if isBursar();
      allow update: if isBursar() && resource != null;
      allow delete: if isBursar() && resource != null;
    }

    /**
     * @description Allows authenticated users to read student information. Write access is open for now, but should be restricted later.
     * @path /students/{studentId}
     * @allow get, list: if isSignedIn();
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Allows all authenticated users to read students.
     */
    match /students/{studentId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows a student to manage their own fee payment records.
     * @path /students/{studentId}/feesPayments/{feesPaymentId}
     * @allow get, list: if isOwner(studentId);
     * @allow create: if isOwner(studentId) && request.resource.data.studentId == studentId;
     * @allow update: if isExistingOwner(studentId) && request.resource.data.studentId == studentId;
     * @allow delete: if isExistingOwner(studentId);
     * @principle Enforces document ownership for writes and validates relational integrity.
     */
    match /students/{studentId}/feesPayments/{feesPaymentId} {
      allow get, list: if isOwner(studentId);
      allow create: if isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isExistingOwner(studentId) && request.resource.data.studentId == studentId;
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Allows users with the 'bursar' role to manage term billing information.
     * @path /termBilling/{termBillingId}
     * @allow get, list: if isBursar();
     * @allow create: if isBursar();
     * @allow update: if isBursar() && resource != null;
     * @allow delete: if isBursar() && resource != null;
     * @principle Enforces role-based access control for term billing data.
     */
    match /termBilling/{termBillingId} {
      allow get, list: if isBursar();
      allow create: if isBursar();
      allow update: if isBursar() && resource != null;
      allow delete: if isBursar() && resource != null;
    }

    /**
     * @description Defines the 'bursar' role based on the existence of a document in this collection.
     * @path /roles_bursar/{userId}
     * @allow get: if false;
     * @allow list: if false;
     * @allow create: if request.auth.uid == userId;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Defines the 'bursar' role.
     */
     match /roles_bursar/{userId} {
        allow get: if false;
        allow list: if false;
        allow create: if request.auth.uid == userId;
        allow update: if false;
        allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    function isBursar() {
        return exists(/databases/$(database)/documents/roles_bursar/$(request.auth.uid));
    }
  }
}