/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict access control based on
 * clearly defined ownership. It errs on the side of caution, restricting
 * access unless explicitly allowed.  Data shape validation is relaxed to
 * facilitate rapid prototyping.
 *
 * Data Structure:
 * The Firestore database contains the following top-level collections:
 * - /students/{studentId}: Stores student information.
 * - /bankAccounts/{accountId}: Stores bank account information.
 * - /payments/{paymentId}: Stores payment records.
 * - /transactions/{transactionId}: Stores bank transactions.
 * - /settings/exchangeRate: Stores the current exchange rate (single document).
 *
 * Key Security Decisions:
 * - Students Collection: Students can only be created, updated, and read by
 *   authenticated users if they own the student id i.e. studentId = request.auth.uid. Listing of all students is forbidden.
 * - BankAccounts, Payments, and Transactions Collections: create, update, and delete operations are forbidden. Listing and getting the data can be done by any signed in user.
 * - ExchangeRate Document: Read access is public. Writes are denied (to be updated via backend functions only).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Secures the /students collection.
     * @path /students/{studentId}
     * @allow (create) Authenticated user creates a student document with their own ID.
     * @allow (get) Authenticated user retrieves a student document with their own ID.
     * @allow (update) Authenticated user updates a student document with their own ID.
     * @allow (delete) Authenticated user deletes a student document with their own ID.
     * @deny (create) Authenticated user attempts to create a student document with another user's ID.
     * @deny (list) Any user attempts to list all student documents.
     * @principle Enforces document ownership for all write operations and restricts listing.
     */
    match /students/{studentId} {
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.id == studentId;
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if false;
      allow update: if isSignedIn() && isOwner(studentId) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isOwner(studentId) && resource != null;
    }

    /**
     * @description Secures the /bankAccounts collection.
     * @path /bankAccounts/{accountId}
     * @allow (get, list) Any signed-in user can read bank account information.
     * @deny (create, update, delete) No one can create, update, or delete bank accounts.
     * @principle Restricts write access to bank account information, open access to read
     */
    match /bankAccounts/{accountId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Secures the /payments collection.
     * @path /payments/{paymentId}
     * @allow (get, list) Any signed-in user can read payments.
     * @deny (create, update, delete) No one can create, update, or delete payments.
     * @principle No writes allowed to the Payments collection.
     */
    match /payments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Secures the /transactions collection.
     * @path /transactions/{transactionId}
     * @allow (get, list) Any signed-in user can read transactions.
     * @deny (create, update, delete) No one can create, update, or delete transactions.
     * @principle Restricts write access to transactions.
     */
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Secures the /settings/exchangeRate document.
     * @path /settings/exchangeRate
     * @allow (get) Any user can read the exchange rate.
     * @deny (create, update, delete) No one can create, update, or delete the exchange rate.
     * @principle Public read access to the exchange rate, no writes allowed.
     */
    match /settings/exchangeRate {
      allow get: if true;
      allow create, update, delete: if false;
    }
  }
}