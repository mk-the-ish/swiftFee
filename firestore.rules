/**
 * @file Firestore Security Rules
 * @description This ruleset enforces role-based access control and ownership-based access control.
 *
 * Data Structure:
 * - /exchangeRates/{exchangeRateId}: Publicly accessible exchange rate data.
 * - /bankAccounts/{bankAccountId}: Bank account information restricted to users with the 'bursar' role.
 * - /students/{studentId}: Student information, accessible to everyone.
 * - /students/{studentId}/feesPayments/{feesPaymentId}: Fee payment records for each student, accessible to everyone.
 * - /termBilling/{termBillingId}: Term billing information, restricted to users with the 'bursar' role.
 * - /roles_bursar/{userId}: Collection to define bursar roles, accessible to the bursar.
 *
 * Key Security Decisions:
 * - Public read access to exchange rates, student data, and fee payments.
 * - Role-based access control for bank accounts and term billing.
 * - Explicitly denies listing of bank accounts and term billing to non-bursar roles.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read exchange rate data. Only allows create, update, and delete to authenticated users.
     * @path /exchangeRates/{exchangeRateId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isSignedIn()
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Allows public read access to exchange rate data, owner-only writes
     */
    match /exchangeRates/{exchangeRateId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows users with the 'bursar' role to manage bank account information.
     * @path /bankAccounts/{bankAccountId}
     * @allow (get, list, create, update, delete): if isBursar(request.auth.uid)
     * @deny (get, list, create, update, delete): if !isBursar(request.auth.uid)
     * @principle Enforces role-based access control for sensitive financial data.
     */
    match /bankAccounts/{bankAccountId} {
      allow get, list, create, update, delete: if isBursar(request.auth.uid);
    }

    /**
     * @description Allows anyone to read student information. Only allows create, update, and delete to authenticated users.
     * @path /students/{studentId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isSignedIn()
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Allows public read access to student data, owner-only writes
     */
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read fee payment records for each student. Only allows create, update, and delete to authenticated users.
     * @path /students/{studentId}/feesPayments/{feesPaymentId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isSignedIn()
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Allows public read access to student fees payments, owner-only writes
     */
    match /students/{studentId}/feesPayments/{feesPaymentId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows users with the 'bursar' role to manage term billing information.
     * @path /termBilling/{termBillingId}
     * @allow (get, list, create, update, delete): if isBursar(request.auth.uid)
     * @deny (get, list, create, update, delete): if !isBursar(request.auth.uid)
     * @principle Enforces role-based access control for sensitive financial data.
     */
    match /termBilling/{termBillingId} {
      allow get, list, create, update, delete: if isBursar(request.auth.uid);
    }

    /**
     * @description Allows a bursar to manage their own role document.
     * @path /roles_bursar/{userId}
     * @allow create: if isOwner(userId);
     * @allow get: if isOwner(userId);
     * @allow update: if isOwner(userId) && resource != null;
     * @allow delete: if isOwner(userId) && resource != null;
     * @allow list: if false;
     * @principle Enforces ownership for managing bursar role assignments.
     */
    match /roles_bursar/{userId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
      allow list: if false;
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user is the owner of the document.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has the 'bursar' role.
     * @param {string} userId The user ID to check.
     * @return {bool} True if the user has the 'bursar' role, false otherwise.
     */
    function isBursar(userId) {
        return exists(/databases/$(database)/documents/roles_bursar/$(userId));
    }
  }
}