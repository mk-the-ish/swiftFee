/**
 * @file Firebase Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model for bank accounts and bursar roles,
 * and an ownership model for student data and fees payments.
 *
 * Data Structure:
 * - /exchangeRates/{exchangeRateId}: Publicly accessible exchange rate data.
 * - /bankAccounts/{bankAccountId}: Bank account data, accessible only to bursars.
 * - /students/{studentId}: Student information.
 * - /students/{studentId}/feesPayments/{feesPaymentId}: Fee payment records for each student, accessible only to the student's owner (or potentially bursars, but bursar access is not implemented here).
 * - /termBilling/{termBillingId}: Term billing information, accessible only to bursars.
 * - /roles_bursar/{userId}: Collection to store bursar roles.
 *
 * Key Security Decisions:
 * - Exchange rates are publicly readable.
 * - Bank accounts and term billing information are restricted to bursars.
 * - Student and fee payment data is primarily owner-controlled, but bursar access could be added later.
 * - User listing is generally disallowed.
 *
 * Denormalization for Authorization:
 * No explicit denormalization is performed in this ruleset as the structure is designed around role-based and ownership-based access which do not require data duplication.
 *
 * Structural Segregation:
 * Different data types (student data, bank accounts, exchange rates) are stored in separate collections with distinct security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to exchange rate data.
     * @path /exchangeRates/{exchangeRateId}
     * @allow (get, list) Any user can read exchange rates.
     * @deny (create, update, delete) No user can create, update, or delete exchange rates.
     * @principle Allows public read-only access to exchange rate data.
     */
    match /exchangeRates/{exchangeRateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows bursars to manage bank account information.
     * @path /bankAccounts/{bankAccountId}
     * @allow (get, list, create, update, delete) Bursars can manage bank accounts.
     * @deny (get, list, create, update, delete) Non-bursars cannot manage bank accounts.
     * @principle Restricts bank account access to users with the 'bursar' role.
     */
    match /bankAccounts/{bankAccountId} {
      allow get, list: if isBursar(request.auth.uid);
      allow create: if isBursar(request.auth.uid);
      allow update: if isBursar(request.auth.uid);
      allow delete: if isBursar(request.auth.uid);
    }

    /**
     * @description Allows access to student information.
     * @path /students/{studentId}
     * @allow (get, list) Any user can read students.
     * @deny (create, update, delete) No user can create, update, or delete students.
     * @principle Restricts writes to student data.
     */
    match /students/{studentId} {
        allow get, list: if true; // Allowing all users to read students.
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Allows access to fees payment records for each student.
     * @path /students/{studentId}/feesPayments/{feesPaymentId}
     * @allow (get, list, create, update, delete) Owner can access fees payments.
     * @deny (get, list, create, update, delete) Non-owner cannot access fees payments.
     * @principle Enforces document ownership for writes and reads.
     */
    match /students/{studentId}/feesPayments/{feesPaymentId} {
      allow get: if isSignedIn() && request.auth.uid == studentId;
      allow list: if isSignedIn() && request.auth.uid == studentId;
      allow create: if isSignedIn() && request.auth.uid == studentId;
      allow update: if isSignedIn() && request.auth.uid == studentId;
      allow delete: if isSignedIn() && request.auth.uid == studentId;
    }

    /**
     * @description Allows bursars to manage term billing information.
     * @path /termBilling/{termBillingId}
     * @allow (get, list, create, update, delete) Bursars can manage term billing.
     * @deny (get, list, create, update, delete) Non-bursars cannot manage term billing.
     * @principle Restricts term billing access to users with the 'bursar' role.
     */
    match /termBilling/{termBillingId} {
      allow get, list: if isBursar(request.auth.uid);
      allow create: if isBursar(request.auth.uid);
      allow update: if isBursar(request.auth.uid);
      allow delete: if isBursar(request.auth.uid);
    }

    /**
     * @description Grants bursar role to a user.
     * @path /roles_bursar/{userId}
     * @allow create: if request.auth.uid == userId;
     * @allow get: if isBursar(request.auth.uid);
     * @deny list: if true;
     * @deny update, delete: if true;
     * @principle Only the user themselves can create their bursar role document.
     */
    match /roles_bursar/{userId} {
      allow create: if request.auth.uid == userId;
      allow get: if isBursar(request.auth.uid);
      allow list: if false;
      allow update, delete: if false;
    }

     /**
      * @description Allows public read access to settings.
      * @path /settings/exchangeRate
      * @allow (get) Any user can read exchange rates.
      * @deny (create, update, delete) No user can create, update, or delete settings.
      * @principle Allows public read-only access to settings data.
      */
     match /settings/exchangeRate {
       allow get: if true;
       allow create, update, delete: if false;
     }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBursar(userId) {
      return exists(/databases/$(database)/documents/roles_bursar/$(userId));
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}