/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for the school management application.
 *
 * Core Philosophy:
 *  - Strict access control based on user authentication and role-based authorization.
 *  - Public read access to certain settings.
 *  - Owner-only write access for all data.
 *
 * Data Structure:
 *  - /students/{studentId}: Student records.
 *  - /bankAccounts/{accountId}: School bank account information.
 *  - /payments/{paymentId}: Payment records.
 *  - /transactions/{transactionId}: Bank transaction records.
 *  - /settings/exchangeRate: Exchange rate settings.
 *
 * Key Security Decisions:
 *  - Users must be authenticated to perform any write operation.
 *  - Listing of students, bank accounts, payments, and transactions is denied to client.
 *  - Exchange rate is publicly readable.
 *
 * Denormalization for Authorization:
 *  - None (all authorization is based on authenticated user and/or public read access).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants read access to the exchange rate and denies all write operations.
     * @path /settings/exchangeRate
     * @allow (get, list): if true
     * @deny (create, update, delete): Always
     * @principle Allows public read access to the exchange rate.
     */
    match /settings/exchangeRate {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure student records.
     * @path /students/{studentId}
     * @deny (get, list, create, update, delete): Always
     * @principle No access is allowed to this data via security rules, it is likely controlled by Cloud Functions.
     */
    match /students/{studentId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure bank account records.
     * @path /bankAccounts/{accountId}
     * @deny (get, list, create, update, delete): Always
     * @principle No access is allowed to this data via security rules, it is likely controlled by Cloud Functions.
     */
    match /bankAccounts/{accountId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure payment records.
     * @path /payments/{paymentId}
     * @deny (get, list, create, update, delete): Always
     * @principle No access is allowed to this data via security rules, it is likely controlled by Cloud Functions.
     */
    match /payments/{paymentId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure transaction records.
     * @path /transactions/{transactionId}
     * @deny (get, list, create, update, delete): Always
     * @principle No access is allowed to this data via security rules, it is likely controlled by Cloud Functions.
     */
    match /transactions/{transactionId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}