/**
 * @file Firebase Security Rules
 * @description This ruleset defines access control for the Cloud Firestore database used by the school management application.
 *
 * Core Philosophy:
 * The security model is based on strict separation of data and role-based access control. Only authenticated users can access the database.
 * Public read access is enabled for specific collections where appropriate, while write access is restricted to authorized roles.
 *
 * Data Structure:
 * The Firestore database consists of the following top-level collections:
 * - /students/{studentId}: Stores information about individual students.
 * - /bankAccounts/{accountId}: Stores bank account details.
 * - /payments/{paymentId}: Stores records of student payments.
 * - /transactions/{transactionId}: Stores bank transaction records.
 * - /settings/exchangeRate: Stores the current exchange rate.
 *
 * Key Security Decisions:
 * - Listing of students is denied to all users. This is a critical security measure to prevent unauthorized access to student data.
 * - Exchange rates are publicly readable but only modifiable by admins (not yet implemented but kept in mind).
 * - Data shape validation is relaxed for prototyping purposes, focusing on authorization and relational integrity.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to student documents.
     * @path /students/{studentId}
     * @allow (get) Authenticated user can read a student document.
     * @deny (list) No user can list student documents.
     * @allow (create) No user can create student documents.
     * @allow (update) No user can update student documents.
     * @allow (delete) No user can delete student documents.
     * @principle Denies listing of student documents for privacy.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to bank account documents.
     * @path /bankAccounts/{accountId}
     * @allow (get) Authenticated user can read a bank account document.
     * @allow (list) Authenticated user can list bank account documents.
     * @allow (create) No user can create bank account documents.
     * @allow (update) No user can update bank account documents.
     * @allow (delete) No user can delete bank account documents.
     * @principle Restricts write access to bank account documents.
     */
    match /bankAccounts/{accountId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to payment documents.
     * @path /payments/{paymentId}
     * @allow (get) Authenticated user can read a payment document.
     * @allow (list) Authenticated user can list payment documents.
     * @allow (create) No user can create payment documents.
     * @allow (update) No user can update payment documents.
     * @allow (delete) No user can delete payment documents.
     * @principle Restricts write access to payment documents.
     */
    match /payments/{paymentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to transaction documents.
     * @path /transactions/{transactionId}
     * @allow (get) Authenticated user can read a transaction document.
     * @allow (list) Authenticated user can list transaction documents.
     * @allow (create) No user can create transaction documents.
     * @allow (update) No user can update transaction documents.
     * @allow (delete) No user can delete transaction documents.
     * @principle Restricts write access to transaction documents.
     */
    match /transactions/{transactionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to the exchange rate document.
     * @path /settings/exchangeRate
     * @allow (get) Any user can read the exchange rate.
     * @allow (list) No user can list the exchange rate document.
     * @allow (create) No user can create the exchange rate document.
     * @allow (update) No user can update the exchange rate document.
     * @allow (delete) No user can delete the exchange rate document.
     * @principle Allows public read access to the exchange rate, restricts write access.
     */
    match /settings/exchangeRate {
        allow get: if true;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }

  // Helper function to determine if a user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }
}