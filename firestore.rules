/**
 * @file Firebase Security Rules for Fees Management Application
 *
 * @description This ruleset enforces a role-based access control model for bank accounts and term billing,
 *              and an ownership model for student data and fee payments. It prioritizes authorization
 *              independence and prevents unauthorized data access.
 *
 * @dataStructure
 * - /exchangeRates/{exchangeRateId}: Public data for exchange rates.
 * - /bankAccounts/{bankAccountId}: Restricted to users with the 'bursar' role.
 * - /students/{studentId}: Stores individual student records.
 * - /students/{studentId}/feesPayments/{feesPaymentId}: Stores fee payment records for each student, accessible only by the owner.
 * - /termBilling/{termBillingId}: Restricted to users with the 'bursar' role.
 * - /roles_bursar/{userId}: Indicates users with the 'bursar' role.
 *
 * @keySecurityDecisions
 * - Public read access to exchange rates.
 * - Bursar role required to access bank accounts and term billing.
 * - Students can only manage their own fee payment records.
 * - Listing bank accounts and term billings is restricted to users with the 'bursar' role.
 *
 * @denormalizationForAuthorization
 * - The rules leverage the path and document IDs for authorization, avoiding the need for extra `get()` calls.
 * - Role-based access for bank accounts and term billing is determined by the presence of a user ID in the `roles_bursar` collection.
 *
 * @structuralSegregation
 * - Student data and bank account data are stored in separate collections to enforce different access controls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to exchange rate data. Only authenticated users can create, update, and delete.
     * @path /exchangeRates/{exchangeRateId}
     * @allow (get, list): if true;
     * @allow (create, update, delete): if isSignedIn();
     * @deny (create, update, delete): if !isSignedIn();
     * @principle Allows public read access to exchange rates, but only authenticated users can modify the data.
     */
    match /exchangeRates/{exchangeRateId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Restricts access to bank account data to users with the 'bursar' role.
     * @path /bankAccounts/{bankAccountId}
     * @allow (get, list): if isBursar(request.auth.uid);
     * @allow (create, update, delete): if isBursar(request.auth.uid);
     * @deny (get, list): if !isBursar(request.auth.uid);
     * @deny (create, update, delete): if !isBursar(request.auth.uid);
     * @principle Enforces role-based access control for sensitive financial data.
     */
    match /bankAccounts/{bankAccountId} {
      allow get, list: if isBursar(request.auth.uid);
      allow create, update, delete: if isBursar(request.auth.uid);
    }

    /**
     * @description Allows read access to student data. Only authenticated users can create, update, and delete.
     * @path /students/{studentId}
     * @allow (get, list): if true;
     * @allow (create): if isSignedIn();
     * @allow (update, delete): if isSignedIn();
     * @deny (create, update, delete): if !isSignedIn();
     * @principle Allows public read access to student records, but requires authentication for modifications.
     */
    match /students/{studentId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    /**
     * @description Allows a student to manage their own fee payment records.
     * @path /students/{studentId}/feesPayments/{feesPaymentId}
     * @allow (get, list): if isOwner(studentId);
     * @allow (create): if isOwner(studentId);
     * @allow (update, delete): if isExistingOwner(studentId);
     * @deny (create): if request.resource.data.studentId != studentId;
     * @deny (update, delete): if resource.data.studentId != studentId;
     * @principle Enforces document ownership for fee payments.
     */
    match /students/{studentId}/feesPayments/{feesPaymentId} {
      allow get, list: if isOwner(studentId);
      allow create: if isOwner(studentId) && (request.resource.data.studentId == studentId);
      allow update, delete: if isExistingOwner(studentId) && (resource.data.studentId == studentId);
    }

    /**
     * @description Restricts access to term billing data to users with the 'bursar' role.
     * @path /termBilling/{termBillingId}
     * @allow (get, list): if isBursar(request.auth.uid);
     * @allow (create, update, delete): if isBursar(request.auth.uid);
     * @deny (get, list): if !isBursar(request.auth.uid);
     * @deny (create, update, delete): if !isBursar(request.auth.uid);
     * @principle Enforces role-based access control for term billing data.
     */
    match /termBilling/{termBillingId} {
      allow get, list: if isBursar(request.auth.uid);
      allow create, update, delete: if isBursar(request.auth.uid);
    }

    /**
     * @description Grants the 'bursar' role to a user.
     * @path /roles_bursar/{userId}
     * @allow get: if true;
     * @allow list: if false;
     * @allow create: if true;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Defines the 'bursar' role and restricts listing, updating, and deleting roles.
     */
    match /roles_bursar/{userId} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return True if the user is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the document.
     * @param userId The user ID to compare against the authenticated user's ID.
     * @return True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     * @param userId The user ID to compare against the authenticated user's ID.
     * @return True if the user IDs match and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user has the 'bursar' role.
     * @param userId The user ID to check for the role.
     * @return True if the user has the role, false otherwise.
     */
    function isBursar(userId) {
      return exists(/databases/$(database)/documents/roles_bursar/$(userId));
    }
  }
}