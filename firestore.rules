rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to exchange rates but restricts write access to ensure data integrity.
     * @path /exchangeRates/{exchangeRateId}
     * @allow (get, list): if true
     * @deny (create, update, delete): if false // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Allows public read with restricted writes.
     */
    match /exchangeRates/{exchangeRateId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Restricts access to bank account data to users with the 'bursar' role.
     * @path /bankAccounts/{bankAccountId}
     * @allow (get, list): if isBursar()
     * @allow (create, update, delete): if isBursar()
     * @deny (get, list): if !isBursar()
     * @deny (create, update, delete): if !isBursar()
     * @principle Enforces role-based access control.
     */
    match /bankAccounts/{bankAccountId} {
      allow get, list: if isBursar();
      allow create, update, delete: if isBursar();
    }

    /**
     * @description Restricts access to student data to the student themselves (owner).
     * @path /students/{studentId}
     * @allow (get, list): if isOwner(studentId)
     * @allow create: if isOwner(studentId)
     * @allow update: if isExistingOwner(studentId)
     * @allow delete: if isExistingOwner(studentId)
     * @deny (get, list): if !isOwner(studentId)
     * @deny create: if !isOwner(studentId)
     * @deny update: if !isExistingOwner(studentId)
     * @deny delete: if !isExistingOwner(studentId)
     * @principle Enforces document ownership for all operations.
     */
    match /students/{studentId} {
      allow get, list: if isOwner(studentId);
      allow create: if request.auth.uid == studentId;
      allow update: if isOwner(studentId);
      allow delete: if isOwner(studentId);
    }

    /**
     * @description Restricts access to fees payment data to the student themselves (owner).
     * @path /students/{studentId}/feesPayments/{feesPaymentId}
     * @allow (get, list): if isOwner(studentId)
     * @allow create: if isOwner(studentId)
     * @allow update: if isExistingOwner(studentId)
     * @allow delete: if isExistingOwner(studentId)
     * @deny (get, list): if !isOwner(studentId)
     * @deny create: if !isOwner(studentId)
     * @deny update: if !isExistingOwner(studentId)
     * @deny delete: if !isExistingOwner(studentId)
     * @principle Enforces document ownership for all operations.
     */
    match /students/{studentId}/feesPayments/{feesPaymentId} {
      allow get, list: if isOwner(studentId);
      allow create: if isOwner(studentId);
      allow update: if isOwner(studentId);
      allow delete: if isOwner(studentId);
    }

    /**
     * @description Restricts access to term billing data to users with the 'bursar' role.
     * @path /termBilling/{termBillingId}
     * @allow (get, list): if isBursar()
     * @allow (create, update, delete): if isBursar()
     * @deny (get, list): if !isBursar()
     * @deny (create, update, delete): if !isBursar()
     * @principle Enforces role-based access control.
     */
    match /termBilling/{termBillingId} {
      allow get, list: if isBursar();
      allow create, update, delete: if isBursar();
    }

     /**
      * @description Allows defining which users have the 'bursar' role. Only writeable by a potential admin user.
      * @path /roles_bursar/{userId}
      * @allow get, list: if false;
      * @allow create: if isAdmin();
      * @allow update: if isAdmin();
      * @allow delete: if isAdmin();
      * @principle Enforces role-based access control.
      */
    match /roles_bursar/{userId} {
        allow get, list: if false;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }
  }

  // ------ Helper functions ------

  /**
   * @description Checks if the user is signed in.
   * @return {boolean} True if the user is signed in, false otherwise.
   */
  function isSignedIn() {
    return request.auth != null;
  }

  /**
   * @description Checks if the user is the owner of the document.
   * @param {string} studentId The user ID to check against.
   * @return {boolean} True if the user is the owner, false otherwise.
   */
  function isOwner(studentId) {
    return isSignedIn() && request.auth.uid == studentId;
  }

    /**
   * @description Checks if the user is the owner of the document and the document exists.
   * @param {string} studentId The user ID to check against.
   * @return {boolean} True if the user is the owner and the document exists, false otherwise.
   */
  function isExistingOwner(studentId) {
    return isOwner(studentId) && exists(/databases/$(database)/documents/students/$(studentId));
  }

  /**
   * @description Checks if the user has the 'bursar' role.
   * @return {boolean} True if the user has the 'bursar' role, false otherwise.
   */
  function isBursar() {
    return isSignedIn() && exists(/databases/$(database)/documents/roles_bursar/$(request.auth.uid));
  }

    /**
   * @description Checks if the user has the 'admin' role.
   * @return {boolean} True if the user has the 'admin' role, false otherwise.
   */
  function isAdmin() {
    // TODO: Implement admin check (e.g., using a custom claim or a dedicated collection)
    return false;
  }
}