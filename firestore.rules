/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict owner-only access model for students, bank accounts, payments, and transactions.
 * The exchange rate can be read by all authenticated users.
 *
 * @dataStructure
 * - /students/{studentId}: Student records, only accessible by the owner (the student's userId).
 * - /bankAccounts/{accountId}: Bank account information, only accessible by the owner.
 * - /payments/{paymentId}: Payment records, only accessible by the owner.
 * - /transactions/{transactionId}: Transaction records, only accessible by the owner.
 * - /settings/exchangeRate: Publicly readable exchange rate settings.
 *
 * @keySecurityDecisions
 * - User listing is disallowed for all collections to prevent data exposure.
 * - The exchange rate is publicly readable to allow the application to function.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to student documents.
     * @path /students/{studentId}
     * @allow (create) - Authenticated user creates a student document where the studentId matches their own user ID.
     * @deny (create) - Authenticated user attempts to create a student document with a studentId that does not match their own user ID.
     * @allow (get) - Authenticated user retrieves their own student document.
     * @deny (get) - Authenticated user attempts to retrieve a student document that is not their own.
     * @allow (update, delete) - Authenticated user updates or deletes their own student document.
     * @deny (update, delete) - Authenticated user attempts to update or delete a student document that is not their own.
     * @principle Enforces document ownership for all operations.
     */
    match /students/{studentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(studentId) {
        return isSignedIn() && request.auth.uid == studentId;
      }

      function isExistingOwner(studentId) {
        return isSignedIn() && request.auth.uid == studentId;
      }

      allow get: if isOwner(studentId);
      allow list: if false; // Listing students is not permitted

      allow create: if isOwner(studentId);
      allow update: if isExistingOwner(studentId);
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Controls access to bank account documents.
     * @path /bankAccounts/{accountId}
     * @allow (create) - Authenticated user creates a bank account document.
     * @deny (create) - Non-authenticated user attempts to create a bank account document.
     * @allow (get) - Authenticated user retrieves a bank account document if the user ID matches the accountId.
     * @deny (get) - Non-authenticated user attempts to retrieve a bank account document.
     * @allow (update, delete) - Authenticated user updates or deletes a bank account document if the user ID matches the accountId.
     * @deny (update, delete) - Non-authenticated user attempts to update or delete a bank account document.
     * @principle Enforces document ownership for all operations.
     */
    match /bankAccounts/{accountId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(accountId) {
        return isSignedIn() && request.auth.uid == accountId;
      }

      allow get: if isOwner(accountId);
      allow list: if false; // Listing bank accounts is not permitted
      allow create: if isSignedIn();
      allow update: if isOwner(accountId);
      allow delete: if isOwner(accountId);
    }

    /**
     * @description Controls access to payment documents.
     * @path /payments/{paymentId}
     * @allow (create) - Authenticated user creates a payment document.
     * @deny (create) - Non-authenticated user attempts to create a payment document.
     * @allow (get) - Authenticated user retrieves a payment document if the user ID matches the paymentId.
     * @deny (get) - Non-authenticated user attempts to retrieve a payment document.
     * @allow (update, delete) - Authenticated user updates or deletes a payment document if the user ID matches the paymentId.
     * @deny (update, delete) - Non-authenticated user attempts to update or delete a payment document.
     * @principle Enforces document ownership for all operations.
     */
    match /payments/{paymentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(paymentId) {
        return isSignedIn() && request.auth.uid == paymentId;
      }

      allow get: if isOwner(paymentId);
      allow list: if false; // Listing payments is not permitted
      allow create: if isSignedIn();
      allow update: if isOwner(paymentId);
      allow delete: if isOwner(paymentId);
    }

    /**
     * @description Controls access to transaction documents.
     * @path /transactions/{transactionId}
     * @allow (create) - Authenticated user creates a transaction document.
     * @deny (create) - Non-authenticated user attempts to create a transaction document.
     * @allow (get) - Authenticated user retrieves a transaction document if the user ID matches the transactionId.
     * @deny (get) - Non-authenticated user attempts to retrieve a transaction document.
     * @allow (update, delete) - Authenticated user updates or deletes a transaction document if the user ID matches the transactionId.
     * @deny (update, delete) - Non-authenticated user attempts to update or delete a transaction document.
     * @principle Enforces document ownership for all operations.
     */
    match /transactions/{transactionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(transactionId) {
        return isSignedIn() && request.auth.uid == transactionId;
      }

      allow get: if isOwner(transactionId);
      allow list: if false; // Listing transactions is not permitted
      allow create: if isSignedIn();
      allow update: if isOwner(transactionId);
      allow delete: if isOwner(transactionId);
    }

    /**
     * @description Controls access to the exchange rate document.
     * @path /settings/exchangeRate
     * @allow (get, list) - All users can read the exchange rate.
     * @deny (create, update, delete) - No users can create, update, or delete the exchange rate.
     * @principle Allows public read access to the exchange rate.
     */
    match /settings/exchangeRate {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}