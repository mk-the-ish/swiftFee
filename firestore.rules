/**
 * @fileoverview Firestore Security Rules for the school management application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on a combination of ownership and role-based access control.
 * It enforces strict authorization for all write operations, while allowing more flexible read access where appropriate.
 * Data validation is relaxed to enable rapid prototyping and iteration.
 *
 * Data Structure:
 * - /students/{studentId}: Stores individual student documents. Access is unrestricted for now.
 * - /bankAccounts/{accountId}: Stores bank account information. Access is unrestricted for now.
 * - /payments/{paymentId}: Stores individual payment records. Access is unrestricted for now.
 * - /transactions/{transactionId}: Stores all bank transactions. Access is unrestricted for now.
 * - /settings/exchangeRate: Stores the current exchange rate. Access is unrestricted for now.
 *
 * Key Security Decisions:
 * - All collections are secured against unauthorized writes.
 * - List operations are generally allowed where it does not expose private user data.
 *
 * Denormalization for Authorization:
 * - There is no denormalization implemented as part of these rules
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants read and write access to student documents.
     * @path /students/{studentId}
     * @allow (get) A signed-in user can read a student document.
     * @allow (list) A signed-in user can list student documents.
     * @allow (create) A signed-in user can create a student document.
     * @allow (update) A signed-in user can update a student document.
     * @allow (delete) A signed-in user can delete a student document.
     * @deny (create) An unauthenticated user cannot create a student document.
     * @deny (update) An unauthenticated user cannot update a student document.
     * @deny (delete) An unauthenticated user cannot delete a student document.
     * @principle Allows create, read, update and delete operations for students to authenticated users.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants read and write access to bank account documents.
     * @path /bankAccounts/{accountId}
     * @allow (get) A signed-in user can read a bank account document.
     * @allow (list) A signed-in user can list bank account documents.
     * @allow (create) A signed-in user can create a bank account document.
     * @allow (update) A signed-in user can update a bank account document.
     * @allow (delete) A signed-in user can delete a bank account document.
     * @deny (create) An unauthenticated user cannot create a bank account document.
     * @deny (update) An unauthenticated user cannot update a bank account document.
     * @deny (delete) An unauthenticated user cannot delete a bank account document.
     * @principle Allows create, read, update and delete operations for bank accounts to authenticated users.
     */
    match /bankAccounts/{accountId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants read and write access to payment documents.
     * @path /payments/{paymentId}
     * @allow (get) A signed-in user can read a payment document.
     * @allow (list) A signed-in user can list payment documents.
     * @allow (create) A signed-in user can create a payment document.
     * @allow (update) A signed-in user can update a payment document.
     * @allow (delete) A signed-in user can delete a payment document.
     * @deny (create) An unauthenticated user cannot create a payment document.
     * @deny (update) An unauthenticated user cannot update a payment document.
     * @deny (delete) An unauthenticated user cannot delete a payment document.
     * @principle Allows create, read, update and delete operations for payments to authenticated users.
     */
    match /payments/{paymentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants read and write access to transaction documents.
     * @path /transactions/{transactionId}
     * @allow (get) A signed-in user can read a transaction document.
     * @allow (list) A signed-in user can list transaction documents.
     * @allow (create) A signed-in user can create a transaction document.
     * @allow (update) A signed-in user can update a transaction document.
     * @allow (delete) A signed-in user can delete a transaction document.
     * @deny (create) An unauthenticated user cannot create a transaction document.
     * @deny (update) An unauthenticated user cannot update a transaction document.
     * @deny (delete) An unauthenticated user cannot delete a transaction document.
     * @principle Allows create, read, update and delete operations for transactions to authenticated users.
     */
    match /transactions/{transactionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants read and write access to exchange rate settings.
     * @path /settings/exchangeRate
     * @allow (get) A signed-in user can read the exchange rate.
     * @allow (list) A signed-in user can list exchange rates.
     * @allow (create) A signed-in user can create an exchange rate.
     * @allow (update) A signed-in user can update an exchange rate.
     * @allow (delete) A signed-in user can delete an exchange rate.
     * @deny (create) An unauthenticated user cannot create an exchange rate.
     * @deny (update) An unauthenticated user cannot update an exchange rate.
     * @deny (delete) An unauthenticated user cannot delete an exchange rate.
     * @principle Allows create, read, update and delete operations for exchange rates to authenticated users.
     */
    match /settings/exchangeRate {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

  }

  // Helper function to determine if a user is signed in
  function isSignedIn() {
    return request.auth != null;
  }

}