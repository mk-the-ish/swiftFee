/**
 * @fileoverview Firestore Security Rules for the school management application.
 *
 * Core Philosophy:
 * This ruleset operates under a public-read, owner-write security model for most collections,
 * with the exception of the `/students` collection, which is write-protected.
 * This approach allows open access for data display while ensuring that only
 * authenticated users with appropriate authority can modify the data.
 *
 * Data Structure:
 * - /students/{studentId}: Stores individual student records.  Writes are disallowed.
 * - /bankAccounts/{accountId}: Stores bank account information.
 * - /payments/{paymentId}: Stores individual payment records.
 * - /transactions/{transactionId}: Stores bank transaction records.  Listing is disallowed.
 * - /settings/exchangeRate: Stores the current exchange rate.  Accessed as a single document.
 *
 * Key Security Decisions:
 * - Listing of `/transactions` is disallowed due to the sensitive nature of financial data.
 * - All write operations require authentication to ensure data integrity.
 *
 * Denormalization for Authorization:
 * N/A - No denormalization is currently used in this ruleset, but could be applied in the future.
 *
 * Structural Segregation:
 * N/A - No structural segregation is used in this ruleset.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Disallows write access to the /students collection. Read access is public.
     * @path /students/{studentId}
     * @allow get, list: if true
     * @deny create, update, delete: if false
     * @principle Protects student records from unauthorized modification.
     */
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access, and authenticated write access to bank account documents.
     * @path /bankAccounts/{accountId}
     * @allow get, list: if true
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Authenticated users can manage bank account information.
     */
    match /bankAccounts/{accountId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows public read access, and authenticated write access to payment documents.
     * @path /payments/{paymentId}
     * @allow get, list: if true
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Authenticated users can manage payment records.
     */
    match /payments/{paymentId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows authenticated write access to transaction documents, but listing is denied.
     * @path /transactions/{transactionId}
     * @allow get: if true;
     * @deny list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Prevents unauthorized access to sensitive transaction data by disallowing listing.
     */
    match /transactions/{transactionId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows public read access, and authenticated write access to the exchange rate document.
     * @path /settings/exchangeRate
     * @allow get: if true
     * @allow list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Authenticated users can manage the exchange rate settings.
     */
    match /settings/exchangeRate {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}