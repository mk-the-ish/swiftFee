/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model, with specific focus on securing bank account information.
 *
 * Data Structure:
 * - /exchangeRates/{exchangeRateId}: Publicly readable exchange rate data.
 * - /bankAccounts/{bankAccountId}: Bank account information, accessible only to users with the 'bursar' role.
 * - /students/{studentId}: Student information.
 * - /students/{studentId}/feesPayments/{feesPaymentId}: Fee payment records for each student.
 * - /termBilling/{termBillingId}: Term billing information, accessible only to users with the 'bursar' role.
 * - /roles_bursar/{userId}: Documents indicating a user has the 'bursar' role.
 *
 * Key Security Decisions:
 * - Bank account listing is restricted to 'bursar' roles.
 * - All writes are protected by authorization checks.
 * - Public read access is granted to exchange rate data.
 *
 * Denormalization for Authorization:
 * - The presence of a document in `/roles_bursar/{userId}` indicates that the user has the 'bursar' role, avoiding costly `get()` calls.
 *
 * Structural Segregation:
 * - Bank accounts and student data are stored in separate top-level collections with differing access requirements.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read exchange rates, but restricts writes.
     * @path /exchangeRates/{exchangeRateId}
     * @allow (get, list): if true
     * @deny (create, update, delete): if false
     * @principle Grants public read access and restricts writes to authorized users.
     */
    match /exchangeRates/{exchangeRateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Restricts access to bank accounts to users with the 'bursar' role.
     * @path /bankAccounts/{bankAccountId}
     * @allow (get, list): if isBursar(request.auth.uid)
     * @allow (create, update, delete): if isBursar(request.auth.uid)
     * @deny (get, list): if !isSignedIn()
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Enforces role-based access control for sensitive bank account information.
     */
    match /bankAccounts/{bankAccountId} {
      allow get, list: if isBursar(request.auth.uid);
      allow create: if isBursar(request.auth.uid);
      allow update: if isBursar(request.auth.uid) && resource != null;
      allow delete: if isBursar(request.auth.uid) && resource != null;
    }

    /**
     * @description Allows read and write access to student data.
     * @path /students/{studentId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if false // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle placeholder to require an ownership field.
     */
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows access to fees payments records for each student.
     * @path /students/{studentId}/feesPayments/{feesPaymentId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if false // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle placeholder to require an ownership field.
     */
    match /students/{studentId}/feesPayments/{feesPaymentId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Restricts access to term billing information to users with the 'bursar' role.
     * @path /termBilling/{termBillingId}
     * @allow (get, list): if isBursar(request.auth.uid)
     * @allow (create, update, delete): if isBursar(request.auth.uid)
     * @deny (get, list): if !isBursar(request.auth.uid)
     * @deny (create, update, delete): if !isBursar(request.auth.uid)
     * @principle Enforces role-based access control for term billing data.
     */
    match /termBilling/{termBillingId} {
      allow get, list: if isBursar(request.auth.uid);
      allow create: if isBursar(request.auth.uid);
      allow update: if isBursar(request.auth.uid) && resource != null;
      allow delete: if isBursar(request.auth.uid) && resource != null;
    }

    /**
     * @description Defines a bursar role based on the existence of a document in this collection.
     * @path /roles_bursar/{userId}
     */
    match /roles_bursar/{userId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBursar(userId) {
      return exists(/databases/$(database)/documents/roles_bursar/$(userId));
    }
  }
}