/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model, with a focus on data segregation and authorization independence.
 *
 * Data Structure:
 * - /exchangeRates/{exchangeRateId}: Publicly accessible exchange rate data.
 * - /bankAccounts/{bankAccountId}: Bank account information, accessible only to users with the 'bursar' role.
 * - /students/{studentId}: Student information.
 * - /students/{studentId}/feesPayments/{feesPaymentId}: Fee payment records for each student, accessible only by the student.
 * - /termBilling/{termBillingId}: Term billing information, accessible only to users with the 'bursar' role.
 * - /roles_bursar/{userId}: Collection indicating users with the 'bursar' role.
 *
 * Key Security Decisions:
 * - Public read access for exchange rates.
 * - Role-based access for bank accounts and term billing (bursar role).
 * - Owner-only access for student data and their fee payments.
 * - Prevents unauthorized listing of bank accounts by requiring the 'bursar' role.
 * - Authorization independence is achieved by avoiding `get()` calls in rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to exchange rate data.
     * @path /exchangeRates/{exchangeRateId}
     * @allow (get, list) Any user can read exchange rate data.
     * @deny (create, update, delete) No user can create, update, or delete exchange rate data.
     * @principle Allows public read access while restricting write access.
     */
    match /exchangeRates/{exchangeRateId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read and write access to bank account information only for users with the 'bursar' role.
     * @path /bankAccounts/{bankAccountId}
     * @allow (get, list, create, update, delete) A user with the 'bursar' role can access bank account information.
     * @deny (get, list, create, update, delete) A user without the 'bursar' role cannot access bank account information.
     * @principle Enforces role-based access control for sensitive financial data.
     */
    match /bankAccounts/{bankAccountId} {
      allow get: if isBursar();
      allow list: if isBursar();
      allow create: if isBursar();
      allow update: if isBursar();
      allow delete: if isBursar();
    }

    /**
     * @description Allows read and write access to student information only for the student themselves.
     * @path /students/{studentId}
     * @allow (get, list, create, update, delete) A student can access their own information.
     * @deny (get, list, create, update, delete) A student cannot access another student's information.
     * @principle Enforces document ownership for student data.
     */
    match /students/{studentId} {
      allow get: if isOwner(studentId);
      allow list: if false;
      allow update: if isOwner(studentId);
      allow delete: if isOwner(studentId);
      allow create: if request.auth.uid == studentId;
    }

    /**
     * @description Allows read and write access to fee payment records only for the student to whom the records belong.
     * @path /students/{studentId}/feesPayments/{feesPaymentId}
     * @allow (get, list, create, update, delete) A student can access their own fee payment records.
     * @deny (get, list, create, update, delete) A student cannot access another student's fee payment records.
     * @principle Enforces document ownership for fee payment records.
     */
    match /students/{studentId}/feesPayments/{feesPaymentId} {
      allow get: if isOwner(studentId);
      allow list: if false;
      allow update: if isOwner(studentId);
      allow delete: if isOwner(studentId);
      allow create: if isOwner(studentId);
    }

    /**
     * @description Allows read and write access to term billing information only for users with the 'bursar' role.
     * @path /termBilling/{termBillingId}
     * @allow (get, list, create, update, delete) A user with the 'bursar' role can access term billing information.
     * @deny (get, list, create, update, delete) A user without the 'bursar' role cannot access term billing information.
     * @principle Enforces role-based access control for sensitive billing data.
     */
    match /termBilling/{termBillingId} {
      allow get: if isBursar();
      allow list: if isBursar();
      allow create: if isBursar();
      allow update: if isBursar();
      allow delete: if isBursar();
    }

     /**
      * @description Grants access to users who have the 'bursar' role.
      * @path /roles_bursar/{userId}
      */
    match /roles_bursar/{userId} {
        allow get: if false; // Nobody should be listing the roles or getting the role documents.  This is for authorization only.
        allow list: if false; // Nobody should be listing the roles or getting the role documents.  This is for authorization only.
        allow create: if request.auth.uid == userId;
        allow update: if false; // Roles should be managed by an admin function, not client-side.
        allow delete: if false; // Roles should be managed by an admin function, not client-side.
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isBursar() {
      return exists(/databases/$(database)/documents/roles_bursar/$(request.auth.uid));
    }
  }
}