/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model.
 *
 * Data Structure:
 * - /students/{studentId}: Stores student information, secured to prevent public access.
 * - /bankAccounts/{accountId}: Stores bank account information, secured to prevent public access.
 * - /payments/{paymentId}: Stores payment records, secured to prevent public access.
 * - /transactions/{transactionId}: Stores transaction records, secured to prevent public access.
 * - /settings/exchangeRate: Stores the exchange rate, secured to prevent public access.
 *
 * Key Security Decisions:
 * - No public listing of any collections is allowed, enforcing data privacy.
 * - All collections require authentication to access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Restricts access to the students collection.
     * @path /students/{studentId}
     * @allow (create) - authenticated user can create a student document with a matching studentId.
     * @deny (create) - unauthenticated user attempts to create a student document.
     * @deny (update) - any user attempts to update an existing student document.
     * @deny (delete) - any user attempts to delete an existing student document.
     * @deny (get) - any user attempts to get a student document.
     * @deny (list) - any user attempts to list student documents.
     * @principle Enforces authentication for all operations.
     */
    match /students/{studentId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to the bankAccounts collection.
     * @path /bankAccounts/{accountId}
     * @allow (create) - authenticated user can create a bank account document with a matching accountId.
     * @deny (create) - unauthenticated user attempts to create a bank account document.
     * @deny (update) - any user attempts to update an existing bank account document.
     * @deny (delete) - any user attempts to delete an existing bank account document.
     * @deny (get) - any user attempts to get a bank account document.
     * @deny (list) - any user attempts to list bank account documents.
     * @principle Enforces authentication for all operations.
     */
    match /bankAccounts/{accountId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to the payments collection.
     * @path /payments/{paymentId}
     * @allow (create) - authenticated user can create a payment document with a matching paymentId.
     * @deny (create) - unauthenticated user attempts to create a payment document.
     * @deny (update) - any user attempts to update an existing payment document.
     * @deny (delete) - any user attempts to delete an existing payment document.
     * @deny (get) - any user attempts to get a payment document.
     * @deny (list) - any user attempts to list payment documents.
     * @principle Enforces authentication for all operations.
     */
    match /payments/{paymentId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to the transactions collection.
     * @path /transactions/{transactionId}
     * @allow (create) - authenticated user can create a transaction document with a matching transactionId.
     * @deny (create) - unauthenticated user attempts to create a transaction document.
     * @deny (update) - any user attempts to update an existing transaction document.
     * @deny (delete) - any user attempts to delete an existing transaction document.
     * @deny (get) - any user attempts to get a transaction document.
     * @deny (list) - any user attempts to list transaction documents.
     * @principle Enforces authentication for all operations.
     */
    match /transactions/{transactionId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to the exchange rate settings.
     * @path /settings/exchangeRate
     * @allow (create) - authenticated user can create a exchange rate document.
     * @deny (create) - unauthenticated user attempts to create a exchange rate document.
     * @deny (update) - any user attempts to update an existing exchange rate document.
     * @deny (delete) - any user attempts to delete an existing exchange rate document.
     * @deny (get) - any user attempts to get the exchange rate document.
     * @deny (list) - any user attempts to list exchange rate documents.
     * @principle Enforces authentication for all operations.
     */
    match /settings/exchangeRate {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}