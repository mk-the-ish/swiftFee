rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces administrator-only access for managing student data.
     * @path /students/{studentId}
     * @allow (create, update, delete) - As an admin, create a new student record.
     * @deny (create, update, delete) - As a non-admin, attempt to create a student record.
     * @allow (get) - As an admin, fetch a specific student's data.
     * @deny (list) - Listing all students is not permitted by anyone.
     * @principle Restricts student data management to authorized personnel.
     */
    match /students/{studentId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Enforces administrator-only access for managing bank account data.
     * @path /bankAccounts/{accountId}
     * @allow (create, update, delete) - As an admin, create a new bank account record.
     * @deny (create, update, delete) - As a non-admin, attempt to create a bank account record.
     * @allow (get) - As an admin, fetch a specific bank account's data.
     * @deny (list) - Listing all bank accounts is not permitted by anyone.
     * @principle Restricts bank account data management to authorized personnel.
     */
    match /bankAccounts/{accountId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Enforces administrator-only access for managing payment records.
     * @path /payments/{paymentId}
     * @allow (create, update, delete) - As an admin, create a new payment record.
     * @deny (create, update, delete) - As a non-admin, attempt to create a payment record.
     * @allow (get) - As an admin, fetch a specific payment's data.
     * @deny (list) - Listing all payments is not permitted due to the reported error and implicit assumption in the reasoning section of docs/backend.json.
     * @principle Restricts payment data management to authorized personnel.
     */
    match /payments/{paymentId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Enforces administrator-only access for managing transaction records.
     * @path /transactions/{transactionId}
     * @allow (create, update, delete) - As an admin, create a new transaction record.
     * @deny (create, update, delete) - As a non-admin, attempt to create a transaction record.
     * @allow (get) - As an admin, fetch a specific transaction's data.
     * @deny (list) - Listing all transactions is not permitted by anyone.
     * @principle Restricts transaction data management to authorized personnel.
     */
    match /transactions/{transactionId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows public read access to the exchange rate while restricting write access to administrators.
     * @path /settings/exchangeRate
     * @allow (get, list) - Any user can retrieve the exchange rate.
     * @allow (create, update, delete) - Only administrators can modify the exchange rate.
     * @deny (create, update, delete) - A non-administrator attempts to modify the exchange rate.
     * @principle Balances public accessibility with administrative control for sensitive settings.
     */
    match /settings/exchangeRate {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Helper functions

    /**
     * @description Checks if the user is an administrator.  This requires a custom claim on the user's JWT.
     * @return {boolean} True if the user has the 'admin' claim set to true.
     */
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}