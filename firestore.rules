
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBursar() {
      return exists(/databases/$(database)/documents/roles_bursar/$(request.auth.uid));
    }

    /**
     * @description Secures access to student documents.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isBursar(); 
      allow create: if isBursar();
      allow update: if isBursar();
      allow delete: if isBursar();

      /**
       * @description Secures payment records for each student.
       * Only bursars can manage payments.
       */
      match /feesPayments/{feesPaymentId} {
        allow read, list, create: if isBursar();
        allow update, delete: if isBursar();
      }
    }

    /**
     * @description Secures access to bank account information.
     */
    match /bankAccounts/{accountId} {
      allow read, list, create, update, delete: if isBursar();
    }

    /**
     * @description Secures access to bank transaction data.
     */
    match /transactions/{transactionId} {
      allow get: if isSignedIn();
      allow list: if false; // Deny listing for all users
      allow create, update, delete: if isBursar();
    }
    
    /**
     * @description Secures the admin log. Readable by bursars, append-only for users.
     */
    match /admin_logs/{logId} {
      allow read, list: if isBursar();
      allow create: if isSignedIn();
      allow update, delete: if false; // Logs are immutable
    }

    /**
     * @description Allows public read access to the exchange rate.
     */
    match /settings/exchangeRate {
      allow get, list: if true;
      allow create, update: if isBursar();
      allow delete: if false;
    }

    /**
     * @description Secures access to user-created notes.
     */
    match /notes/{noteId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
    
    /**
     * @description Role definitions. Should only be managed from the Firebase Console.
     */
    match /roles_bursar/{userId} {
      allow read, write: if false;
    }
  }
}
