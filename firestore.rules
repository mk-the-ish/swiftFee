/**
 * @fileOverview Firestore Security Rules for the school management application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by default.  All data access requires authentication.
 * Bank account information is restricted from listing.
 *
 * Data Structure:
 * - /students/{studentId}: Student records.
 * - /bankAccounts/{accountId}: School bank accounts.
 * - /payments/{paymentId}: Payment records.
 * - /transactions/{transactionId}: Bank transaction records.
 * - /settings/exchangeRate: Exchange rate settings.
 *
 * Key Security Decisions:
 * - Listing of bank accounts is denied to prevent unauthorized access to sensitive financial information.
 * - All write operations require authentication.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to student records.
     * @path /students/{studentId}
     * @allow (create) - Authenticated user can create a student record.
     * @allow (get) - Authenticated user can get a student record.
     * @allow (list) - Authenticated user can list student records.
     * @allow (update) - Authenticated user can update a student record.
     * @allow (delete) - Authenticated user can delete a student record.
     * @deny (create) - Unauthenticated user attempts to create a student record.
     * @principle Authenticated users can manage student records.
     */
    match /students/{studentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages access to bank account information.
     * @path /bankAccounts/{accountId}
     * @allow (create) - Authenticated user can create a bank account record.
     * @allow (get) - Authenticated user can get a bank account record.
     * @deny (list) - Listing of bank accounts is explicitly denied for all users.
     * @allow (update) - Authenticated user can update a bank account record.
     * @allow (delete) - Authenticated user can delete a bank account record.
     * @deny (create) - Unauthenticated user attempts to create a bank account record.
     * @principle Restricts listing of bank accounts while allowing authenticated users to manage individual records.
     */
    match /bankAccounts/{accountId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages access to payment records.
     * @path /payments/{paymentId}
     * @allow (create) - Authenticated user can create a payment record.
     * @allow (get) - Authenticated user can get a payment record.
     * @allow (list) - Authenticated user can list payment records.
     * @allow (update) - Authenticated user can update a payment record.
     * @allow (delete) - Authenticated user can delete a payment record.
     * @deny (create) - Unauthenticated user attempts to create a payment record.
     * @principle Authenticated users can manage payment records.
     */
    match /payments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages access to bank transaction records.
     * @path /transactions/{transactionId}
     * @allow (create) - Authenticated user can create a transaction record.
     * @allow (get) - Authenticated user can get a transaction record.
     * @allow (list) - Authenticated user can list transaction records.
     * @allow (update) - Authenticated user can update a transaction record.
     * @allow (delete) - Authenticated user can delete a transaction record.
     * @deny (create) - Unauthenticated user attempts to create a transaction record.
     * @principle Authenticated users can manage transaction records.
     */
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages access to the exchange rate setting.
     * @path /settings/exchangeRate
     * @allow (get) - Authenticated user can get the exchange rate.
     * @allow (list) - Authenticated user can list the settings (though there's only one document).
     * @allow (create) - Authenticated user can create the exchange rate setting.
     * @allow (update) - Authenticated user can update the exchange rate setting.
     * @allow (delete) - Authenticated user can delete the exchange rate setting.
     * @deny (create) - Unauthenticated user attempts to create the exchange rate setting.
     * @principle Authenticated users can manage the exchange rate setting.
     */
    match /settings/exchangeRate {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }

  // Helper function to determine if a user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }
}