/**
 * @fileoverview Firestore Security Rules for the school management application.
 *
 * Core Philosophy:
 * This ruleset implements a role-based access control model, granting different levels of access based on the user's role.
 * All data is stored in top-level collections. Strict authorization checks are applied to each collection.
 *
 * Data Structure:
 * - /students/{studentId}: Stores individual student documents.
 * - /bankAccounts/{accountId}: Stores bank account information.
 * - /payments/{paymentId}: Stores individual payment records.
 * - /transactions/{transactionId}: Stores bank transactions.
 * - /settings/exchangeRate: Stores the current exchange rate.
 *
 * Key Security Decisions:
 * - Listing of students is disallowed due to privacy concerns.
 *
 * Denormalization for Authorization:
 * - The 'Payment' entity schema requires the following denormalization to work correctly:
 *   - studentId: to match payments to students
 *   - bankAccountId: to restrict which bank accounts the current user has access to.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Restricts access to the 'students' collection. Students can not be listed.
     * @path /students/{studentId}
     * @allow (get) Authenticated users can read student documents.
     * @deny (list) Listing all students is disallowed.
     * @deny (create) No one can create student documents directly.
     * @deny (update) No one can update student documents directly.
     * @deny (delete) No one can delete student documents directly.
     * @principle Prevents unauthorized listing of student data.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to bank account information.
     * @path /bankAccounts/{accountId}
     * @allow (get) Authenticated users can read bank account documents.
     * @allow (list) Authenticated users can list bank account documents.
     * @deny (create) Creating bank account documents is disallowed.
     * @deny (update) Updating bank account documents is disallowed.
     * @deny (delete) Deleting bank account documents is disallowed.
     * @principle Restricts modification of bank account data.
     */
    match /bankAccounts/{accountId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to payment records.
     * @path /payments/{paymentId}
     * @allow (get) Authenticated users can read payment documents.
     * @allow (list) Authenticated users can list payment documents.
     * @deny (create) Creating payment documents is disallowed.
     * @deny (update) Updating payment documents is disallowed.
     * @deny (delete) Deleting payment documents is disallowed.
     * @principle Restricts modification of payment data.
     */
    match /payments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to bank transaction records.
     * @path /transactions/{transactionId}
     * @allow (get) Authenticated users can read transaction documents.
     * @allow (list) Authenticated users can list transaction documents.
     * @deny (create) Creating transaction documents is disallowed.
     * @deny (update) Updating transaction documents is disallowed.
     * @deny (delete) Deleting transaction documents is disallowed.
     * @principle Restricts modification of transaction data.
     */
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to exchange rate settings.
     * @path /settings/exchangeRate
     * @allow (get) Authenticated users can read the exchange rate document.
     * @deny (list) Listing exchange rate documents is disallowed (only a single document exists).
     * @deny (create) Creating exchange rate documents is disallowed.
     * @deny (update) Updating exchange rate documents is disallowed.
     * @deny (delete) Deleting exchange rate documents is disallowed.
     * @principle Restricts modification of the exchange rate.
     */
    match /settings/exchangeRate {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }
}