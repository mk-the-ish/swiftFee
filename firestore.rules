/**
 * @fileoverview Firestore Security Rules for the school administration app.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on a combination of
 * role-based access control and data ownership. It enforces strict
 * authorization for write operations while providing more flexible read
 * access where appropriate, especially for data intended for general
 * consumption.
 *
 * Data Structure:
 * The Firestore database contains collections for students, bank accounts,
 * payments, transactions, and settings. Each collection stores documents
 * representing individual entities.
 *
 * Key Security Decisions:
 * - Students: Read access is public, but writes are forbidden due to lack of defined role to control access.
 * - Bank Accounts: Read and write access is restricted to authenticated users.
 * - Payments: Read and write access is restricted to authenticated users.
 * - Transactions: Read and write access is restricted to authenticated users.
 * - Exchange Rate: Read access is public, write access is forbidden as there is no owner field.
 *
 * Denormalization for Authorization:
 * This ruleset does not currently implement denormalization. Further development
 * may include adding `ownerId` fields to documents to simplify ownership checks
 * and improve performance.
 *
 * Structural Segregation:
 * This ruleset does not currently implement structural segregation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages student data. Read access is public, write access is not supported due to lack of defined role to control access.
     * @path /students/{studentId}
     * @allow (get, list): Any user can read student data.
     * @deny (create, update, delete): No user can create, update, or delete student data.
     * @principle Allows public reads but disallows all writes due to lack of ownership field.
     */
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages bank account information. Restricted to authenticated users.
     * @path /bankAccounts/{accountId}
     * @allow (get, list): Any authenticated user can read bank account data.
     * @allow (create, update, delete): No user can create, update, or delete bank account data.
     * @deny (create, update, delete): No one can write since there is no ownership or roles defined.
     * @principle Requires authentication for all operations.
     */
    match /bankAccounts/{accountId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Manages payment records. Restricted to authenticated users.
     * @path /payments/{paymentId}
     * @allow (get, list): Any authenticated user can read payment records.
     * @allow (create, update, delete): No user can create, update, or delete payment records.
     * @deny (create, update, delete): No one can write since there is no ownership or roles defined.
     * @principle Requires authentication for all operations.
     */
    match /payments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Manages bank transactions. Restricted to authenticated users.
     * @path /transactions/{transactionId}
     * @allow (get, list): Any authenticated user can read bank transactions.
     * @allow (create, update, delete): No user can create, update, or delete bank transactions.
     * @deny (create, update, delete): No one can write since there is no ownership or roles defined.
     * @principle Requires authentication for all operations.
     */
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Manages the current exchange rate. Read access is public, but writes are not allowed.
     * @path /settings/exchangeRate
     * @allow (get, list): Any user can read the exchange rate.
     * @deny (create, update, delete): No user can create, update, or delete the exchange rate.
     * @principle Allows public reads but disallows all writes due to lack of ownership field.
     */
    match /settings/exchangeRate {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}