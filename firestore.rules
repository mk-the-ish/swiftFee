/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure authorization while keeping data shape validation minimal for rapid prototyping.
 * It uses a strict ownership model for user-specific data and allows public read access where appropriate.
 *
 * Data Structure:
 * - /students/{studentId}: Student records.
 * - /bankAccounts/{accountId}: Bank account information.
 * - /payments/{paymentId}: Payment records.
 * - /transactions/{transactionId}: Bank transactions.
 * - /settings/exchangeRate: Current exchange rate.
 *
 * Key Security Decisions:
 * - No user listing is allowed for any collection.
 * - Students can only be created by authorized users (no public self-registration).
 * - Public read access is granted for the exchange rate.
 *
 * Denormalization for Authorization:
 *  - No denormalization is needed at this stage. All authorization decisions are based on user authentication.
 *
 * Structural Segregation:
 *  - No structural segregation is needed at this stage.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the /students collection. Only authenticated users can create students.
     * @path /students/{studentId}
     * @allow (create) Authenticated user creating a student.
     * @deny (create) Unauthenticated user attempting to create a student.
     * @deny (update) Any user attempting to update a student.
     * @deny (delete) Any user attempting to delete a student.
     * @deny (get) Any user attempting to get a student.
     * @deny (list) Any user attempting to list students.
     * @principle Authenticated users can create students, no updates,deletes,gets, or lists allowed.
     */
    match /students/{studentId} {
      allow create: if isSignedIn();
      allow get: if false;
      allow list: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects the /bankAccounts collection. Only authenticated users can create accounts.
     * @path /bankAccounts/{accountId}
     * @allow (create) Authenticated user creating a bank account.
     * @deny (create) Unauthenticated user attempting to create a bank account.
     * @deny (update) Any user attempting to update a bank account.
     * @deny (delete) Any user attempting to delete a bank account.
     * @deny (get) Any user attempting to get a bank account.
     * @deny (list) Any user attempting to list bank accounts.
     * @principle Authenticated users can create bank accounts, no updates,deletes,gets, or lists allowed.
     */
    match /bankAccounts/{accountId} {
      allow create: if isSignedIn();
      allow get: if false;
      allow list: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects the /payments collection. Only authenticated users can create payments.
     * @path /payments/{paymentId}
     * @allow (create) Authenticated user creating a payment.
     * @deny (create) Unauthenticated user attempting to create a payment.
     * @deny (update) Any user attempting to update a payment.
     * @deny (delete) Any user attempting to delete a payment.
     * @deny (get) Any user attempting to get a payment.
     * @deny (list) Any user attempting to list payments.
     * @principle Authenticated users can create payments, no updates,deletes,gets, or lists allowed.
     */
    match /payments/{paymentId} {
      allow create: if isSignedIn();
      allow get: if false;
      allow list: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects the /transactions collection. Only authenticated users can create transactions.
     * @path /transactions/{transactionId}
     * @allow (create) Authenticated user creating a transaction.
     * @deny (create) Unauthenticated user attempting to create a transaction.
     * @deny (update) Any user attempting to update a transaction.
     * @deny (delete) Any user attempting to delete a transaction.
     * @deny (get) Any user attempting to get a transaction.
     * @deny (list) Any user attempting to list transactions.
     * @principle Authenticated users can create transactions, no updates,deletes,gets, or lists allowed.
     */
    match /transactions/{transactionId} {
      allow create: if isSignedIn();
      allow get: if false;
      allow list: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects the /settings/exchangeRate document. Allows public read access and authenticated write access.
     * @path /settings/exchangeRate
     * @allow (get, list) Any user (authenticated or unauthenticated) can read the exchange rate.
     * @allow (create, update, delete) Only authenticated users can create, update, or delete the exchange rate.
     * @deny (create) Unauthenticated user attempting to create the exchange rate.
     * @deny (update) Unauthenticated user attempting to update the exchange rate.
     * @deny (delete) Unauthenticated user attempting to delete the exchange rate.
     * @principle Provides public read access with authenticated write access.
     */
    match /settings/exchangeRate {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }

  // Helper function to determine if a user is signed in
  function isSignedIn() {
    return request.auth != null;
  }
}