
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBursar() {
      return exists(/databases/$(database)/documents/roles_bursar/$(request.auth.uid));
    }

    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isBursar(); 
      allow create: if isBursar();
      allow update: if isBursar();
      allow delete: if isBursar();
    }
    
    match /payments/{paymentId} {
        allow list, get: if isBursar();
        allow create, delete, update: if isBursar();
    }

    match /bankAccounts/{accountId} {
      allow read, list, create, update, delete: if isBursar();
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn();
      allow list: if isBursar();
      allow create, update, delete: if isBursar();
    }
    
    match /admin_logs/{logId} {
      allow read, list: if isBursar();
      allow create: if isSignedIn();
      allow update, delete: if false; 
    }

    match /settings/exchangeRate {
      allow get, list: if true;
      allow create, update: if isBursar();
      allow delete: if false;
    }

    match /notes/{noteId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
    
    match /roles_bursar/{userId} {
      allow read, write: if false;
    }
  }
}
