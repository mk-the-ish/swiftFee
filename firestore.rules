rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to exchange rates.
     */
    match /exchangeRates/{exchangeRateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages access to bank account information, accessible only to users with the 'bursar' role.
     */
    match /bankAccounts/{bankAccountId} {
      allow get, list, create, update, delete: if isBursar();
    }

    /**
     * @description Manages access to student information.
     */
    match /students/{studentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Manages access to fee payment records for each student.
     */
    match /students/{studentId}/feesPayments/{feesPaymentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Manages access to term billing information, accessible only to users with the 'bursar' role.
     */
    match /termBilling/{termBillingId} {
      allow get, list, create, update, delete: if isBursar();
    }

    /**
     * @description Grants access to the `/payments` collection.
     */
     match /payments/{paymentId} {
        allow list, get: if isBursar();
        allow create, update, delete: if isBursar();
     }

    /**
     * @description Grants access to the roles_bursar collection to define users with the 'bursar' role.
     */
    match /roles_bursar/{userId} {
          allow get, list, create, update: if isBursar();
          allow delete: if false;
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has the 'bursar' role by verifying the existence of a document in the /roles_bursar collection.
     */
    function isBursar() {
      return exists(/databases/$(database)/documents/roles_bursar/$(request.auth.uid));
    }
  }
}