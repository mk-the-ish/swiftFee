/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict access control model for a school management application.
 *
 * Core Philosophy:
 * Only authenticated users can access the database. There is no user-specific data or roles, so authentication is the only factor.
 *
 * Data Structure:
 * The database consists of several top-level collections: `students`, `bankAccounts`, `payments`, and `transactions`, `settings`.
 * - `/students/{studentId}`: Stores student information.
 * - `/bankAccounts/{accountId}`: Stores bank account details.
 * - `/payments/{paymentId}`: Stores payment records.
 * - `/transactions/{transactionId}`: Stores transaction history.
 * - `/settings/exchangeRate`: Stores exchange rate.
 *
 * Key Security Decisions:
 * - Payments are currently readable by anyone.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants read and write access to authenticated users for student documents.
     * @path /students/{studentId}
     * @allow (get, list) Authenticated user can read a student document.
     * @allow (create, update, delete) Authenticated user can create, update, or delete a student document.
     * @deny (get, list) Unauthenticated user cannot read a student document.
     * @deny (create, update, delete) Unauthenticated user cannot create, update, or delete a student document.
     * @principle Authenticated user can access all student data.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants read and write access to authenticated users for bank account documents.
     * @path /bankAccounts/{accountId}
     * @allow (get, list) Authenticated user can read a bank account document.
     * @allow (create, update, delete) Authenticated user can create, update, or delete a bank account document.
     * @deny (get, list) Unauthenticated user cannot read a bank account document.
     * @deny (create, update, delete) Unauthenticated user cannot create, update, or delete a bank account document.
     * @principle Authenticated user can access all bank account data.
     */
    match /bankAccounts/{accountId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants read access to authenticated users for payment documents, write access is allowed for any authenticated user.
     * @path /payments/{paymentId}
     * @allow (get, list) Any user can read a payment document.
     * @allow (create, update, delete) Authenticated user can create, update, or delete a payment document.
     * @deny (create, update, delete) Unauthenticated user cannot create, update, or delete a payment document.
     * @principle Authenticated user can access all payment data.
     */
    match /payments/{paymentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants read and write access to authenticated users for transaction documents.
     * @path /transactions/{transactionId}
     * @allow (get, list) Authenticated user can read a transaction document.
     * @allow (create, update, delete) Authenticated user can create, update, or delete a transaction document.
     * @deny (get, list) Unauthenticated user cannot read a transaction document.
     * @deny (create, update, delete) Unauthenticated user cannot create, update, or delete a transaction document.
     * @principle Authenticated user can access all transaction data.
     */
    match /transactions/{transactionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants read and write access to authenticated users for exchange rate settings.
     * @path /settings/exchangeRate
     * @allow (get, list) Authenticated user can read the exchange rate settings.
     * @allow (create, update, delete) Authenticated user can create, update, or delete the exchange rate settings.
     * @deny (get, list) Unauthenticated user cannot read the exchange rate settings.
     * @deny (create, update, delete) Unauthenticated user cannot create, update, or delete the exchange rate settings.
     * @principle Authenticated user can access the exchange rate settings.
     */
    match /settings/exchangeRate {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }

  // Helper function to determine if a user is signed in
  function isSignedIn() {
    return request.auth != null;
  }
}