/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict access control based on
 * resource ownership or role-based permissions. It assumes a closed-by-default
 * posture, granting access only where explicitly defined. Data validation is
 * relaxed to facilitate rapid prototyping and schema evolution, focusing on
 * authorization-critical fields.
 *
 * Data Structure:
 * - /students/{studentId}: Student records.
 * - /bankAccounts/{accountId}: School bank account information.
 * - /payments/{paymentId}: Student payment records.
 * - /transactions/{transactionId}: Bank transaction records.
 * - /settings/exchangeRate: Exchange rate settings (single document).
 *
 * Key Security Decisions:
 * - Listing of students is disallowed due to privacy concerns.
 * - Only authenticated users can create bank accounts.
 * - Payments and transactions can be created by authenticated users.
 * - The exchange rate can be read by anyone, but writes are denied.
 *
 * Denormalization for Authorization:
 *  N/A - No denormalization implemented in this version
 *
 * Structural Segregation:
 * N/A - No explicit segregation of public vs. private data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures student records. Students can not be listed.
     * @path /students/{studentId}
     * @allow (get) Authenticated user can read a student record.
     * @deny (list) All users are prevented from listing student records.
     * @allow (create, update, delete) No one can create, update or delete a student record.
     * @principle Enforces document ownership for writes.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures bank account information.
     * @path /bankAccounts/{accountId}
     * @allow (create) Authenticated user can create a bank account.
     * @deny (get, list, update, delete) No one can get, list, update, or delete bank accounts.
     * @principle Enforces document ownership for writes.
     */
    match /bankAccounts/{accountId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures payment records.
     * @path /payments/{paymentId}
     * @allow (create) Authenticated user can create a payment.
     * @deny (get, list, update, delete) No one can get, list, update, or delete payments.
     * @principle Enforces document ownership for writes.
     */
    match /payments/{paymentId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures bank transaction records.
     * @path /transactions/{transactionId}
     * @allow (create) Authenticated user can create a transaction.
     * @deny (get, list, update, delete) No one can get, list, update, or delete transactions.
     * @principle Enforces document ownership for writes.
     */
    match /transactions/{transactionId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures the exchange rate settings.
     * @path /settings/exchangeRate
     * @allow (get, list) All users can read the exchange rate.
     * @deny (create, update, delete) No one can create, update, or delete the exchange rate.
     * @principle Enforces document ownership for writes.
     */
    match /settings/exchangeRate {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}

/**
 * @description Checks if the user is signed in.
 * @return {boolean} True if the user is signed in, false otherwise.
 */
function isSignedIn() {
  return request.auth != null;
}