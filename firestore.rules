/**
 * @fileoverview Firestore Security Rules for the School Management App.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on strict ownership for student data.
 * Other data like bank accounts, payments, and transactions are secured behind authentication, and potentially role-based access in the future.
 * Public read access is granted to the exchange rate for general use.
 *
 * Data Structure:
 * - /students/{studentId}: Stores student information. Access is restricted to the student's record.
 * - /bankAccounts/{accountId}: Stores bank account information. Requires user authentication for access.
 * - /payments/{paymentId}: Stores payment records. Requires user authentication for access.
 * - /transactions/{transactionId}: Stores transaction records. Requires user authentication for access.
 * - /settings/exchangeRate: Stores the current exchange rate. Public read access.
 *
 * Key Security Decisions:
 * - No user listing is allowed.
 * - Student records are secured using an ownership model based on the `studentId`.
 * - Bank accounts, payments, and transactions require authentication.
 * - The exchange rate is publicly readable.
 *
 * Denormalization for Authorization:
 *  No denormalization is used in this version.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures student documents.
     * @path /students/{studentId}
     * @allow (create) User with auth.uid 'studentId' can create their own record.
     * @allow (get, update, delete) User with auth.uid 'studentId' can get, update, or delete their record.
     * @deny (create) User with auth.uid != 'studentId' cannot create a student record.
     * @deny (get, update, delete) User with auth.uid != 'studentId' cannot get, update, or delete another student record.
     * @principle Enforces document ownership for writes.
     */
    match /students/{studentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      function isExistingOwner(studentId) {
          return isOwner(studentId) && resource != null;
      }

      allow get: if isOwner(studentId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(studentId);
      allow update: if isExistingOwner(studentId);
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Secures bank account documents.
     * @path /bankAccounts/{accountId}
     * @allow (get, list, create, update, delete) Authenticated user can access bank accounts.
     * @deny (get, list, create, update, delete) Unauthenticated user cannot access bank accounts.
     * @principle Requires authentication for access.
     */
    match /bankAccounts/{accountId} {

      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Secures payment documents.
     * @path /payments/{paymentId}
     * @allow (get, list, create, update, delete) Authenticated user can access payments.
     * @deny (get, list, create, update, delete) Unauthenticated user cannot access payments.
     * @principle Requires authentication for access.
     */
    match /payments/{paymentId} {

      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Secures transaction documents.
     * @path /transactions/{transactionId}
     * @allow (get, list, create, update, delete) Authenticated user can access transactions.
     * @deny (get, list, create, update, delete) Unauthenticated user cannot access transactions.
     * @principle Requires authentication for access.
     */
    match /transactions/{transactionId} {

      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows public read access to the exchange rate.
     * @path /settings/exchangeRate
     * @allow (get, list) Anyone can read the exchange rate.
     * @deny (create, update, delete) Only authenticated users can manage the exchange rate.
     */
    match /settings/exchangeRate {
      allow get, list: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}