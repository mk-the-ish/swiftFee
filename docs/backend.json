{
  "entities": {
    "student": {
      "title": "Student",
      "description": "A student enrolled in the school.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "grade": { "type": "string", "enum": ["ECD A", "ECD B", "Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Grade 6", "Grade 7"] },
        "dateOfBirth": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "guardianName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "address": { "type": "string" },
        "tuitionOwing": { "type": "number" },
        "levyOwing": { "type": "number" },
        "buildingFundOwing": { "type": "number" }
      },
      "required": ["name", "grade", "dateOfBirth", "gender", "guardianName", "guardianPhone", "tuitionOwing", "levyOwing", "buildingFundOwing"]
    },
    "bankAccount": {
      "title": "Bank Account",
      "description": "A bank account for the school.",
      "type": "object",
      "properties": {
        "bankName": { "type": "string" },
        "branch": { "type": "string" },
        "accountNumber": { "type": "string" },
        "currency": { "type": "string", "enum": ["USD", "ZWG"] }
      },
      "required": ["bankName", "accountNumber", "currency"]
    },
    "payment": {
      "title": "Payment",
      "description": "A fee payment made by a student.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "feeType": { "type": "string", "enum": ["tuition", "levy", "building", "exam"] },
        "paymentMethod": { "type": "string", "enum": ["Cash", "Bank Transfer", "Ecocash"] },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "ZWG"] },
        "amountInUSD": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "bankAccountId": { "type": "string" },
        "deposited": { "type": "boolean" }
      },
      "required": ["studentId", "studentName", "receiptNumber", "feeType", "paymentMethod", "amount", "currency", "amountInUSD", "date", "deposited"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "A bank transaction.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "bankAccountId": { "type": "string" },
        "type": { "type": "string", "enum": ["incoming", "outgoing"] },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "relatedPaymentId": { "type": "string" }
      },
      "required": ["date", "bankAccountId", "type", "description", "amount"]
    },
    "exchangeRate": {
      "title": "Exchange Rate",
      "description": "The daily USD to ZWG exchange rate.",
      "type": "object",
      "properties": {
        "rate": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["rate", "lastUpdated"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/student" },
      "description": "Stores individual student documents."
    },
    "/bankAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/bankAccount" },
      "description": "Stores bank account information."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/payment" },
      "description": "Stores individual payment records."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/transaction" },
      "description": "Stores all bank transactions."
    },
    "/settings/exchangeRate": {
      "schema": { "$ref": "#/entities/exchangeRate" },
      "description": "Stores the current exchange rate."
    }
  }
}
