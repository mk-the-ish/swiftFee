
/**
 * @file Firebase Security Rules for Firestore.
 *
 * @core_philosophy This ruleset focuses on securing access to school data,
 * with an emphasis on preventing unauthorized listing of sensitive collections.
 * It prioritizes a secure-by-default posture, restricting access unless
 * explicitly granted. The primary use case is a school management system
 * where only authorized personnel should access financial and student data.
 *
 * @data_structure
 * - /students/{studentId}: Stores individual student records.
 * - /students/{studentId}/feesPayments/{feesPaymentId}: Sub-collection for student payments.
 * - /bankAccounts/{accountId}: Stores bank account information for the school.
 *   Access to this collection is strictly limited.
 * - /transactions/{transactionId}: Stores bank transaction data.
 * - /settings/exchangeRate: Stores the current exchange rate. This is public.
 * - /notes/{noteId}: Stores user-created notes.
 * - /roles_bursar/{userId}: Grants 'bursar' role.
 * - /admin_logs/{logId}: Stores a trail of administrative actions.
 *
 * @key_security_decisions
 * - Payments are now a sub-collection of students for clearer ownership and security.
 * - Deleting payments is restricted to bursars to prevent accidental data loss.
 * - The admin_logs collection is append-only for authenticated users, but only readable by bursars.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBursar() {
      return exists(/databases/$(database)/documents/roles_bursar/$(request.auth.uid));
    }

    /**
     * @description Secures access to student documents.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isBursar(); 
      allow create: if isBursar();
      allow update: if isBursar();
      allow delete: if isBursar();

      /**
       * @description Secures payment records for each student.
       * Only bursars can manage payments.
       */
      match /feesPayments/{feesPaymentId} {
        allow read, list, create: if isBursar();
        allow update, delete: if isBursar();
      }
    }

    /**
     * @description Secures access to bank account information.
     */
    match /bankAccounts/{accountId} {
      allow read, list, create, update, delete: if isBursar();
    }

    /**
     * @description Secures access to bank transaction data.
     */
    match /transactions/{transactionId} {
      allow get: if isSignedIn();
      allow list: if false; // Deny listing for all users
      allow create, update, delete: if isBursar();
    }
    
    /**
     * @description Secures the admin log. Readable by bursars, append-only for users.
     */
    match /admin_logs/{logId} {
      allow read, list: if isBursar();
      allow create: if isSignedIn();
      allow update, delete: if false; // Logs are immutable
    }

    /**
     * @description Allows public read access to the exchange rate.
     */
    match /settings/exchangeRate {
      allow get, list: if true;
      allow create, update: if isBursar();
      allow delete: if false;
    }

    /**
     * @description Secures access to user-created notes.
     */
    match /notes/{noteId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
    
    /**
     * @description Role definitions. Should only be managed from the Firebase Console.
     */
    match /roles_bursar/{userId} {
      allow read, write: if false;
    }
  }
}
